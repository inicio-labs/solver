# solver.toml — runtime configuration template.
#
# Copy this file to `solver.toml` (which is gitignored) and fill in the
# environment-specific values, OR point the binary at any path via the
# `--config <path>` flag or the `SOLVER_CONFIG` env var.
#
#   cp solver.toml.example solver.toml   # then edit the placeholders below

[rpc]
# Miden node gRPC endpoint. The public testnet endpoint is shown as a sane
# default; use your own node for production.
endpoint = "https://rpc.testnet.miden.io"
timeout_ms = 10000
# Remote prover URL (offload proof gen). Omit to prove locally. Recommended on small hosts.
# prover_endpoint = "https://tx-prover.devnet.miden.io"

[solver]
# Hex account ID of the solver's on-chain account. REQUIRED — replace with
# your solver account. (Placeholder; the binary will fail to start with this.)
# Create one with `solver-bin provision-account`. On Miden 0.16 the solver pays
# a fee in the native asset for every settlement: send native tokens to it as a
# PUBLIC note. The solver claims incoming funds by itself, at boot and on every
# sync (`solver-bin fund-account` claims them without starting the solver).
account_id = "0x<your_solver_account_id_hex>"
# Filesystem keystore directory holding the solver account's Falcon key.
# Relative paths resolve against the process working directory.
keystore_path = "./solver_keystore"
# The application database is PostgreSQL. Set SOLVER_DATABASE_URL for its
# writer role and SOLVER_READ_DATABASE_URL for a read-only role in the process
# environment; do not put credentials in this file. Only the Miden client
# stores below remain SQLite, and they must use different files.
executor_store_path = "./executor_store.sqlite3"  # executor miden-client store (signs)
ingest_store_path = "./ingest_store.sqlite3"      # keyless ingest miden-client store
# Concurrent PostgreSQL read connections (matcher hydration, public APIs).
# Defaults to 4 if omitted.
read_pool_size = 4

# One [[pairs]] block per trading pair the solver should watch. faucet IDs
# and external symbols are network-specific — replace the placeholders.
[[pairs]]
name = "USDT-ETH"
asset_x_faucet_id = "0x<asset_x_faucet_id_hex>"
asset_x_external_symbol = "tether"
asset_y_faucet_id = "0x<asset_y_faucet_id_hex>"
asset_y_external_symbol = "ethereum"

[engine]
pulse_interval_ms = 5000
fetch_interval_ms = 3000
# 5s polling will exhaust the CoinGecko Demo free tier (10K/mo) in ~5 days.
# After that, fetches will 429 and the matcher will operate on the last good
# price snapshot until the budget resets. For sustained production, either
# bump this interval, switch providers, or upgrade to a paid CoinGecko tier.
price_interval_ms = 5000
# Exact-price PSWAP pair clearing requires fresh provider prices and on-chain
# token decimals. Missing/stale prices leave the pair's orders in the live book.
# Protocol fee and minimum price edge in ppm; zero disables fees.
clearing_fee_ppm = 0
# clearing_max_source_age_secs = 60  # provider timestamp age, not HTTP fetch age
# clearing_max_source_skew_secs = 30 # difference between the two asset timestamps
# Admin HTTP server port (binds 127.0.0.1 only). Defaults to 3001.
admin_port = 3001
# debug_mode is ignored since Miden 0.16 (miden-client removed debug mode); a
# warning is logged if it is set.
# debug_mode = false
# Observability HTTP server port (binds 127.0.0.1 only). Exposes
# `/health` (liveness), `/readyz` (database reachable, writer ownership, sync freshness),
# and `/metrics` (Prometheus text counters and gauges). No auth.
# Defaults to 9090.
# obs_port = 9090
# While the executor cannot settle (no fee headroom, node RPC or PostgreSQL
# unavailable) it pauses and re-checks this often. Defaults to 5000.
# verify_interval_ms = 5000
# How fresh the last successful sync must be for /readyz to return 200.
# Defaults to 60s. Bump if chain block time + RPC latency exceeds 60s
# under normal conditions.
# readiness_freshness_secs = 60

# Override the price-API base URL. Defaults to the public CoinGecko endpoint.
# The solver always uses its normal HttpPriceClient — only the URL changes, and
# pairs still map tokens -> ids via asset_*_external_symbol. For devnet/local
# where the faucet tokens aren't listed and no COINGECKO_API_KEY is available,
# run the mock CoinGecko service (`cargo run -p mock-price`) and point here.
# Leave commented to use the public CoinGecko API. Do NOT pin a mock on mainnet.
# price_api_base_url = "http://127.0.0.1:8089/api/v3/simple/price"

# ── Public price-query API (wallets fetch token prices) ──────────────────────
# Read-only HTTP endpoint, runs on its own thread. GET /v1/price/{faucet_id} and
# GET /v1/prices?ids=a,b → {faucet_id, ticker, vs_currency, price, precision,
# decimals, as_of, stale, source}. Decimals + ticker are fetched on-chain.
# price_query_port = 8080
# price_query_bind = "127.0.0.1"     # "0.0.0.0" to expose publicly (front w/ a proxy)
# price_query_max_inflight = 128     # concurrent requests; excess → 503
# price_query_max_batch = 50         # max ids per /v1/prices request
# price_query_timeout_ms = 3000
# price_precision = "full"           # decimals of the PRICE number: "full" or 0..=18
#                                    # (per-request override: ?precision=). NOT the token's decimals.
# price_vs_currency = "usd"          # CoinGecko vs_currency (usd/eur/...; NOT "usdt")
# price_staleness_secs = 30          # older than this → 503 (use ?allow_stale=true to override)

# External RFQ routing hands unmatched whole notes to allow-listed DEXes.
# Set SOLVER_ROUTER_TOKENS to comma-separated bearer tokens when enabling it.
# router_enabled = false
# router_bind = "127.0.0.1"
# router_port = 8090
# router_max_connections = 64
# router_max_msg_bytes = 16384
# router_quote_ttl_ms = 20000
# router_inflight_ttl_ms = 30000 # must exceed expected external settlement latency

# Market-maker gRPC gateway (ADR 0003). Plaintext HTTP/2: put a TLS-terminating
# proxy in front of it. Onboard makers and issue API keys through the admin API.
# maker_gateway_enabled = false
# maker_gateway_bind = "127.0.0.1"
# maker_gateway_port = 8095
# maker_intake_round_submits = 500   # most submits per intake transaction
# maker_intake_submit_queue = 4096   # full → UNAVAILABLE, never a hang
# maker_intake_cancel_queue = 1024   # cancels queue separately
